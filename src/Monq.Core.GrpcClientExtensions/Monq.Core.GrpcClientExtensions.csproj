<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <VersionSuffix>$(VersionSuffix)</VersionSuffix>
    <Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Authors>MONQ Digital lab</Authors>
    <Company>MONQ Digital lab</Company>
    <Title>Monq.Core.GrpcClientExtensions</Title>
    <PackageId>Monq.Core.GrpcClientExtensions</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>microservice grpc kubernetes service-discovery load-balancing</PackageTags>
    <Description>Shared gRPC client registration on top of Monq.Core.MicroserviceAddressing: name-based addresses, scheme-aware credentials, round-robin balancing and DNS service discovery.</Description>
    <PackageProjectUrl>https://github.com/MONQDL/Monq.Core.GrpcClientExtensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MONQDL/Monq.Core.GrpcClientExtensions</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--Trimming and AOT-->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server.ClientFactory" Version="2.83.0" />
    <PackageReference Include="Monq.Core.HttpClientExtensions" Version="8.0.0-rev-42260357548" />
    <PackageReference Include="Monq.Core.MicroserviceAddressing" Version="0.3.0-rev-42358150343" />
  </ItemGroup>

</Project>
